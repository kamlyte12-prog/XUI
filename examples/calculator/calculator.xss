tokens {
  // Windows 11 Calculator dark theme, sampled from the real App.xaml theme resources.
  color.window = #202020
  color.pane = #2b2b2b
  color.number = #3c3c3c
  color.function = #333333
  color.number-hover = #333333
  color.number-pressed = #282828
  color.alt-hover = #3c3c3c
  color.alt-pressed = #333333
  color.accent = #4cc2ff
  color.accent-hover = #6acdff
  color.accent-pressed = #3fa9e0
  color.primary = #ffffff
  color.secondary = #c5c5c5
  color.disabled = #5d5d5d
  color.hover-overlay = #ffffff14
  color.pressed-overlay = #ffffff1f
  color.hairline = #ffffff14
  color.smoke = #0000006b
}

Window { resting: { bg: color.window, fg: color.primary, font-size: 14px, radius: 8px } }
// Calculator SVGs are transparent line art. Remove the framework's light Image card default.
Image { resting: { bg: #00000000, border: 1px solid #00000000, radius: 0px } }

// Caption bar. The framework draws minimize/maximize/close zones at the right end.
TitleBar.caption { resting: { bg: color.window, fg: color.primary, pad: 0px 8px, gap: 8px } }
Text.caption-title { resting: { fg: color.secondary, font-size: 12px, align: Start, pad: 0px 2px } }
TitleButton {
  resting: { fg: color.primary }
  hover: { bg: color.hover-overlay, fg: color.primary }
  pressed: { bg: color.pressed-overlay, fg: color.primary }
}

// Stage and toolbar.
Column.calculator { resting: { bg: color.window, gap: 0px, pad: 0px } }
Row.toolbar { resting: { gap: 0px, pad: 0px 4px, align: Center } }
Button.toolbar-button {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, align: Center, justify: Center }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
  focus: { border: 1px solid #ffffff40 }
}
Text.mode-title { resting: { fg: color.primary, font-size: 20px, font-weight: 600, align: Start, pad: 0px 10px } }

// Result display: the real app caps the font at 26 when the window is shorter than 640.
Text.expression { resting: { fg: color.secondary, font-size: 14px, align: End, pad: 0px 6px } }
Text.display { resting: { fg: color.primary, font-size: 26px, font-weight: 300, align: End, pad: 0px 6px } }

// Memory toolbar: text-only keys, disabled until the list has an entry.
Grid.memory-row { resting: { gap: 0px, pad: 0px 4px } }
Button.memory-key {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, font-size: 12px }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
  disabled: { bg: #00000000, fg: color.disabled }
}
Row.memory-dropdown-row { resting: { gap: 2px, align: Center } }
Button.memory-dropdown { resting: { align: Center, justify: Center } }
Text.memory-dropdown-label { resting: { fg: color.primary, font-size: 12px, align: Center } }

// Keypad. Numbers are taller-weight 24px; functions 16px; operators 22px; equals uses
// the light accent with black text, all with the real 4px corner radius and no borders.
Grid.keypad { resting: { bg: color.window, gap: 2px, pad: 3px } }
Button.key {
  resting: { bg: color.number, fg: color.primary, border: 1px solid #00000000, radius: 4px, font-size: 24px, font-weight: 400 }
  hover: { bg: color.number-hover }
  pressed: { bg: color.number-pressed, opacity: 0.92 }
  focus: { border: 1px solid #ffffff40 }
}
Button.key-function {
  resting: { bg: color.function, font-size: 16px }
  hover: { bg: color.alt-hover }
  pressed: { bg: color.alt-pressed }
}
Button.key-operator { resting: { font-size: 22px } }
Button.key-equals {
  resting: { bg: color.accent, fg: #000000, font-size: 24px, font-weight: 500 }
  hover: { bg: color.accent-hover }
  pressed: { bg: color.accent-pressed, opacity: 0.94 }
}
Button.key-icon { resting: { align: Center, justify: Center } }

// History and memory flyouts.
Column.flyout { resting: { bg: color.pane, gap: 0px, pad: 0px } }
Row.flyout-header { resting: { gap: 4px, pad: 0px 6px, align: Center } }
Button.header-button {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, align: Center, justify: Center }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
  focus: { border: 1px solid #ffffff40 }
}
Text.flyout-title { resting: { fg: color.primary, font-size: 20px, font-weight: 600, align: Start, pad: 0px 4px } }
Text.empty-note { resting: { fg: color.secondary, font-size: 14px, align: Start, pad: 14px 10px } }

// History rows stack the expression above the result and reuse the result on click.
Column.history-list { resting: { gap: 0px, pad: 0px 4px } }
Button.history-item {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, pad: 2px 8px, align: Center }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
}
Text.history-expression { resting: { fg: color.secondary, font-size: 12px, align: End } }
Text.history-result { resting: { fg: color.primary, font-size: 20px, align: End } }

// Memory rows: right-aligned value with always-visible MC / M+ / M− actions.
Column.memory-list { resting: { gap: 0px, pad: 0px 4px } }
Column.memory-item { resting: { gap: 0px, pad: 2px 2px } }
Button.memory-recall {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, align: Center }
  hover: { bg: #ffffff0a }
  pressed: { bg: #ffffff12 }
}
Text.memory-item-value { resting: { fg: color.primary, font-size: 20px, align: End, pad: 0px 8px } }
Row.memory-actions { resting: { gap: 4px, pad: 0px 4px, align: Center, justify: End } }
Button.memory-item-action {
  resting: { bg: #ffffff0d, fg: color.primary, border: 1px solid #00000000, radius: 4px, font-size: 12px, pad: 0px }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
}

// Navigation drawer.
Column.drawer { resting: { bg: color.pane, gap: 0px, pad: 0px } }
Row.drawer-top { resting: { gap: 4px, pad: 0px 4px, align: Center } }
Text.drawer-title { resting: { fg: color.primary, font-size: 20px, font-weight: 600, align: Start, pad: 0px 6px } }
ScrollView.drawer-scroll {
  resting: { min-size: 0px 0px, bg: #00000000, border: 1px solid #00000000, radius: 0px, scrollbar-size: 6px, scrollbar-visibility: auto, scroll-track: #00000000, scroll-thumb: #777777a0, scroll-speed: 44 }
  hover: { scroll-thumb: #a0a0a0d0 }
}
Text.drawer-heading { resting: { fg: color.secondary, font-size: 14px, font-weight: 600, align: Start, pad: 10px 12px 4px } }
Row.nav-row { resting: { gap: 12px, pad: 0px 12px, align: Center } }
Text.nav-label { resting: { fg: color.primary, font-size: 14px, align: Start } }
Button.nav-item {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, align: Center }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
  focus: { border: 1px solid #ffffff40 }
}
Button.nav-selected { resting: { bg: #ffffff12 } }
Button.settings-item { resting: { border: 1px solid #ffffff10, radius: 0px } }
Separator.drawer-separator { resting: { bg: #ffffff12 } }

// Mode notice modal.
Stack.modal { resting: { bg: color.smoke } }
Button.modal-scrim { resting: { bg: #00000000, border: 1px solid #00000000, radius: 0px } }
Column.notice-card {
  resting: { bg: color.pane, fg: color.primary, border: 1px solid #ffffff1a, radius: 8px, pad: 14px, gap: 10px, shadow: 0px 10px 30px 4px #00000080 }
}
Row.notice-header { resting: { gap: 4px, align: Center } }
Text.notice-title { resting: { fg: color.primary, font-size: 18px, font-weight: 600, align: Start } }
Button.notice-close {
  resting: { bg: #00000000, fg: color.primary, border: 1px solid #00000000, radius: 4px, align: Center, justify: Center }
  hover: { bg: color.hover-overlay }
  pressed: { bg: color.pressed-overlay }
}
Text.notice-body { resting: { fg: color.secondary, font-size: 14px, align: Start } }
Button.notice-ok {
  resting: { bg: color.accent, fg: #000000, border: 1px solid #00000000, radius: 4px, font-size: 14px, font-weight: 600 }
  hover: { bg: color.accent-hover }
  pressed: { bg: color.accent-pressed }
}
