tokens {
  color.canvas = #101827
  color.surface = #172235
  color.raised = #202f46
  color.hover = #293d59
  color.text = #edf3fb
  color.muted = #a6b5c9
  color.accent = #d7a85c
  color.accent-bright = #ffd27e
  color.outline = #415875
  color.board = #0c1421
  color.cell = #d7a85c
  color.danger = #d76572
}

Window { resting: { bg: color.canvas, fg: color.text, font-size: 14px } }
Column.app { resting: { pad: 16px, gap: 10px } }
Row.masthead { resting: { gap: 14px, align: Center, justify: SpaceBetween } }
Text.title { resting: { fg: color.accent-bright, font-size: 24px, font-weight: 700 } }
Text.subtitle { resting: { fg: color.muted, font-size: 13px } }
FpsCounter.fps, Text.readout { resting: { bg: color.raised, fg: color.text, pad: 6px, border: 1px solid color.outline, radius: 6px, font-size: 12px, align: Center } }

Tabs.pages { resting: { bg: color.surface, border: 1px solid color.outline, radius: 9px } focus: { border: 1px solid color.accent } }
Tab {
  resting: { bg: color.canvas, fg: color.muted, font-size: 12px, pad: 8px 12px }
  hover: { bg: color.hover, fg: color.text }
  selected: { bg: color.surface, fg: color.accent-bright, border: 1px solid color.accent }
}
Panel.page-card { resting: { bg: color.surface, pad: 24px, border: 1px solid color.outline, radius: 9px } }
Panel.board-frame { resting: { bg: color.board, pad: 8px, border: 1px solid color.outline, radius: 8px } }
Column.board { resting: { bg: color.board, gap: 2px } }
ProgressBar.board-cell { resting: { bg: #1b2940, fg: color.cell, border: 1px solid #293b55, radius: 2px } }
Panel.score-card, Panel.piece-card, Panel.controls-card { resting: { bg: color.raised, fg: color.text, pad: 14px, border: 1px solid color.outline, radius: 8px } }

Badge.eyebrow { resting: { bg: #47391f, fg: color.accent-bright, size: auto 26px, pad: 10px 4px, radius: 13px, font-size: 11px, font-weight: 700, align: Center } }
Text.hero { resting: { fg: color.text, font-size: 36px, font-weight: 700, align: Center } }
Text.menu-title { resting: { animation: menu-enter 520ms paused ease-out } }
Text.intro { resting: { fg: color.muted, font-size: 15px, align: Center } }
Text.hint { resting: { fg: color.muted, font-size: 12px, align: Center } }
Text.field-label { resting: { fg: color.muted, font-size: 11px, font-weight: 700 } }
Text.score-value { resting: { fg: color.accent-bright, font-size: 32px, font-weight: 700, margin: 3px 0px 12px } }
Text.stat-value { resting: { fg: color.text, font-size: 20px, font-weight: 650, margin: 2px 0px 10px } }
Text.section-title { resting: { fg: color.text, font-size: 22px, font-weight: 700 } }
Text.body { resting: { fg: color.muted, font-size: 14px } }
Text.panel-title { resting: { fg: color.text, font-size: 15px, font-weight: 700, margin: 0px 0px 8px } }
Text.control-help { resting: { fg: color.muted, font-size: 12px, margin: 6px 0px 4px } }
Text.line-toast { resting: { fg: color.accent-bright, font-size: 18px, font-weight: 700, align: Center, animation: toast-pop 700ms paused ease-out } }
Text.gameover-title { resting: { fg: color.danger, font-size: 40px, font-weight: 700, align: Center, animation: gameover-pulse 900ms paused ease-in-out } }

Button.primary, Button.secondary {
  resting: { bg: color.raised, fg: color.text, pad: 8px 12px, border: 1px solid color.outline, radius: 6px, font-size: 13px, font-weight: 600 }
  hover: { bg: color.hover, border: 1px solid color.accent }
  pressed: { bg: #18283e }
  focus: { border: 1px solid color.accent-bright }
  disabled: { fg: color.muted, opacity: 0.48 }
}
Button.primary { resting: { bg: #765723, fg: #fff7e7, border: 1px solid color.accent } hover: { bg: #8a682d } pressed: { bg: #5b431b } }
Dropdown.dropdown { resting: { bg: color.raised, fg: color.text, pad: 8px, border: 1px solid color.outline, radius: 6px } hover: { bg: color.hover } focus: { border: 1px solid color.accent } open: { border: 1px solid color.accent } }

Tooltip { resting: { bg: #18283e, fg: color.text, pad: 8px, border: 1px solid color.accent, radius: 6px, font-size: 12px } }

keyframes toast-pop {
  from { opacity: 0.2; transform: translateY(6px) scale(0.92) }
  to { opacity: 1; transform: translateY(0px) scale(1) }
}
keyframes menu-enter {
  from { opacity: 0.25; transform: translateY(10px) }
  to { opacity: 1; transform: translateY(0px) }
}
keyframes gameover-pulse {
  from { opacity: 0.55 }
  to { opacity: 1 }
}
