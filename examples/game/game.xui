// Tetris structure and controls are authored here. game.cpp only owns game rules and values.
Window(title: "Xui Tetris", size: 980x760) {
  Column[class: "app", width: 100%, height: 100%, pad: 16px, gap: 10px, minSize: 820x680] {
    Row[class: "masthead", width: 100%, align: Center, justify: SpaceBetween, gap: 14px] {
      Column[grow: 1, gap: 2px] {
        Text("TETRIS")[class: "title"]
        Text("A real-time game loop built on Xui widgets")[class: "subtitle"]
      }
      FpsCounter[id: "fps", class: "fps", width: 240px, height: 30px]
      Text("F3: FPS / ms   F4: batches")[class: "hint", width: 180px, height: 30px]
    }

    Tabs[id: "game-pages", selected: 0, change: onPageChange, class: "pages", width: 100%, height: 100%, grow: 1, minSize: 0x0] {
      Tab(title: "Menu") {
        Panel[class: "page-card", width: 100%, height: 100%, pad: 24px] {
          Column[class: "center-page", width: 100%, height: 100%, gap: 14px, align: Center, justify: Center] {
            Badge("XUI GAME EXAMPLE")[class: "eyebrow"]
            Text("Tetris")[id: "menu-title", class: "hero menu-title"]
            Text("Clear rows, score points, and raise the level using the authored controls.")[class: "intro", width: 620px]
            Row[class: "actions", gap: 10px, align: Center] {
              Button(label: "Play")[press: onStart, class: "primary", width: 140px, height: 42px]
              Button(label: "Settings")[press: onOpenSettings, class: "secondary", width: 140px, height: 42px]
              Button(label: "Quit")[press: onQuit, class: "secondary", width: 110px, height: 42px]
            }
            Text("F3 toggles FPS sampling. F4 toggles draw batches.")[class: "hint"]
          }
        }
      }
      Tab(title: "Game") {
        Row[class: "game-page", width: 100%, height: 100%, gap: 16px, align: Start, pad: 14px] {
          Panel[class: "board-frame", width: 270px, height: 520px, pad: 8px] {
            Column[id: "board", class: "board", gap: 2px, width: 100%, height: 100%] {
              Row[class: "board-row", gap: 2px] {
                ProgressBar[id: "cell-0-0", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-1", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-2", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-3", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-4", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-5", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-6", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-7", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-8", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-0-9", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
              }
              Row[class: "board-row", gap: 2px] {
                ProgressBar[id: "cell-1-0", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-1-1", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-1-2", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-1-3", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
