                ProgressBar[id: "cell-16-1", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-2", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-3", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-4", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-5", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-6", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-7", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-8", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-16-9", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
              }
              Row[class: "board-row", gap: 2px] {
                ProgressBar[id: "cell-17-0", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-1", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-2", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-3", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-4", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-5", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-6", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-7", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-8", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-17-9", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
              }
              Row[class: "board-row", gap: 2px] {
                ProgressBar[id: "cell-18-0", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-1", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-2", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-3", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-4", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-5", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-6", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-7", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-8", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-18-9", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
              }
              Row[class: "board-row", gap: 2px] {
                ProgressBar[id: "cell-19-0", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-1", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-2", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-3", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-4", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-5", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-6", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-7", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-8", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
                ProgressBar[id: "cell-19-9", value: 0, min: 0, max: 1, class: "board-cell", width: 23px, height: 22px]
              }
            }
          }
          Column[class: "sidebar", grow: 1, gap: 10px] {
            Panel[class: "score-card", width: 100%, pad: 14px] {
              Text("SCORE")[class: "field-label"]
              Text("0")[id: "score-readout", class: "score-value"]
              Row[class: "stats-row", width: 100%, gap: 8px] {
                Column[grow: 1, gap: 4px] { Text("LINES")[class: "field-label"] Text("0")[id: "lines-readout", class: "stat-value"] }
                Column[grow: 1, gap: 4px] { Text("LEVEL")[class: "field-label"] Text("1")[id: "level-readout", class: "stat-value"] }
              }
            }
            Panel[class: "piece-card", width: 100%, pad: 14px] {
              Text("CURRENT")[class: "field-label"]
              Text("T")[id: "piece-readout", class: "stat-value"]
              Text("NEXT")[class: "field-label"]
              Text("Next: I")[id: "next-readout", class: "stat-value"]
            }
            Panel[class: "controls-card", width: 100%, pad: 14px] {
              Text("CONTROLS")[class: "panel-title"]
              Text("Move / rotate")[class: "control-help"]
              Row[width: 100%, gap: 6px] {
                Button(label: "← Left")[press: onLeft, class: "secondary", grow: 1, height: 36px]
                Button(label: "Rotate")[press: onRotate, class: "secondary", grow: 1, height: 36px]
                Button(label: "Right →")[press: onRight, class: "secondary", grow: 1, height: 36px]
              }
              Text("Drop")[class: "control-help"]
              Row[width: 100%, gap: 6px] {
                Button(label: "Soft drop")[press: onSoftDrop, class: "secondary", grow: 1, height: 36px]
                Button(label: "Hard drop")[press: onHardDrop, class: "primary", grow: 1, height: 36px]
              }
              Row[width: 100%, gap: 6px] {
                Button(label: "Pause")[press: onPause, class: "secondary", grow: 1, height: 36px]
                Button(label: "Menu")[press: onMainMenu, class: "secondary", grow: 1, height: 36px]
              }
              Text("Use the buttons above to move and drop pieces.")[class: "hint"]
            }
            Text("0 lines cleared")[id: "line-toast", class: "line-toast"]
          }
        }
      }
      Tab(title: "Paused") {
        Panel[class: "page-card", width: 100%, height: 100%, pad: 24px] {
          Column[class: "center-page", width: 100%, height: 100%, gap: 14px, align: Center, justify: Center] {
            Text("Paused")[class: "hero"]
            Text("The gravity timer is stopped while this page is open.")[class: "intro"]
            Row[gap: 10px, align: Center] {
              Button(label: "Resume")[press: onResume, class: "primary", width: 140px, height: 42px]
              Button(label: "Main menu")[press: onMainMenu, class: "secondary", width: 140px, height: 42px]
            }
          }
        }
      }
      Tab(title: "Settings") {
        Panel[class: "page-card", width: 100%, height: 100%, pad: 24px] {
          Column[class: "settings-page", width: 100%, height: 100%, gap: 12px] {
            Text("Game settings")[class: "section-title"]
            Text("Choose the starting level for the next game.")[class: "body"]
            Dropdown[id: "starting-level", options: "1|2|3|4|5", value: "1", class: "dropdown", width: 220px, height: 38px]
            Row[width: 100%, justify: End] {
              Button(label: "Back")[press: onSettingsBack, class: "secondary", width: 120px, height: 40px]
              Button(label: "Play")[press: onStart, class: "primary", width: 120px, height: 40px]
            }
          }
        }
      }
      Tab(title: "Game Over") {
        Panel[class: "page-card", width: 100%, height: 100%, pad: 24px] {
          Column[class: "center-page", width: 100%, height: 100%, gap: 12px, align: Center, justify: Center] {
            Text("GAME OVER")[id: "gameover-title", class: "gameover-title"]
            Text("Score 0")[id: "gameover-score", class: "stat-value"]
            Text("Lines 0")[id: "gameover-lines", class: "stat-value"]
            Row[gap: 10px, align: Center] {
              Button(label: "Play again")[press: onRestart, class: "primary", width: 150px, height: 42px]
              Button(label: "Main menu")[press: onMainMenu, class: "secondary", width: 150px, height: 42px]
            }
          }
        }
      }
    }
  }
}
