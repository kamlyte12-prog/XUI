tokens {
    color.canvas = #111827
    color.text = #f9fafb
    color.muted = #cbd5e1
    color.page = #916920
}

Window { resting: { bg: color.canvas, fg: color.text, font-size: 16px } }
Column.page { resting: { bg: color.page, fg: color.text, pad: 8px, gap: 10px } }
Row.bar { resting: { bg: color.muted, fg: color.canvas, pad: 4px, gap: 12px } }
Text.title { resting: { fg: color.text, font-weight: 700, font-size: 32px } }
