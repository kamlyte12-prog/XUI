// Blender-inspired grey theme: flat surfaces, dark outlines, a single selection blue.
tokens {
  color.canvas = #1d1d1d        // editor background
  color.panel = #303030          // panels and tab bodies
  color.raised = #545454         // widget resting surface
  color.hover = #656565          // widget hover surface
  color.fg = #d8d8d8
  color.muted = #999999
  color.accent = #4772b3         // Blender selection blue
  color.accent-hover = #5684c7
  color.outline = #212121        // dark edge lines
  color.disabled = #747474
}

Window { resting: { bg: color.canvas } }
Text.title { resting: { fg: color.fg, font-size: 24px, font-weight: 700 } }
Text.subtitle { resting: { fg: color.muted, font-size: 13px } }
Text.section-title { resting: { fg: color.muted, font-size: 13px, font-weight: 600 } }
Text.help { resting: { fg: color.muted, font-size: 13px, margin: 0px 0px 4px } }
Text.value-readout { resting: { fg: #9ec2ee, font-size: 13px } }
Text.panel-title { resting: { fg: color.fg, font-size: 15px, font-weight: 600, margin: 0px 0px 8px } }
Text.body { resting: { fg: color.muted, font-size: 14px, pad: 0px 0px 10px } }

FpsCounter.fps { resting: { bg: color.panel, fg: color.fg, font-size: 12px, radius: 3px, border: 1px solid color.outline } }
Tabs.tabs { resting: { bg: color.panel, radius: 4px, border: 1px solid color.outline } focus: { border: 1px solid color.accent } }
Tab {
  resting: { bg: #232323, fg: color.muted, font-size: 13px }
  hover: { bg: #3d3d3d, fg: color.fg }
  selected: { bg: color.panel, fg: color.fg, border: 1px solid color.accent }
  disabled: { opacity: 0.4 }
}
Column.page { resting: { bg: color.panel } }

TextBox.field, TextArea.field {
  resting: { bg: color.raised, fg: color.fg, border: 1px solid color.outline, radius: 3px, pad: 8px, font-size: 14px }
  hover: { bg: color.hover }
  focus: { bg: color.hover, border: 1px solid color.accent }
  readonly: { bg: #3a3a3a, fg: #b8b8b8 }
  placeholder: { fg: #8d8d8d }
  disabled: { opacity: 0.4 }
}
TextBox.picker-channel, TextBox.picker-hex {
  resting: { bg: color.raised, fg: color.fg, border: 1px solid color.outline, radius: 3px, font-size: 12px }
  hover: { bg: color.hover }
  focus: { border: 1px solid color.accent }
  readonly: { bg: #3a3a3a, fg: #b8b8b8 }
  disabled: { opacity: 0.4 }
}
CheckBox.checkbox {
  resting: { bg: color.raised, fg: color.fg, radius: 3px, border: 1px solid color.outline }
  hover: { bg: color.hover }
  focus: { border: 1px solid color.accent }
  checked: { fg: color.accent }
  disabled: { opacity: 0.4 }
}
CheckBox.disabled-check { resting: { fg: color.disabled } }

Button.action, Button.secondary {
  resting: { bg: color.raised, fg: color.fg, radius: 3px, font-size: 14px, border: 1px solid color.outline }
  hover: { bg: color.hover }
  pressed: { bg: #3f3f3f }
  focus: { border: 1px solid color.accent }
  disabled: { bg: #3a3a3a, fg: color.disabled, opacity: 0.5 }
}
Button.disabled-action { resting: { bg: #3a3a3a, fg: color.disabled, opacity: 0.5 } }
Slider.slider { resting: { bg: color.outline, fg: color.accent } hover: { fg: color.accent-hover } focus: { border: 1px solid color.fg } disabled: { opacity: 0.4 } }
ProgressBar.progress { resting: { bg: color.outline, fg: color.accent, radius: 4px } }
Dropdown.dropdown, ColorPicker.color-picker, DatePicker.date, KeybindField.keybind {
  resting: { bg: color.raised, fg: color.fg, radius: 3px, border: 1px solid color.outline }
  hover: { bg: color.hover }
  open: { border: 1px solid color.accent }
  focus: { border: 1px solid color.accent }
  disabled: { opacity: 0.4 }
}
DatePicker.date { resting: { pad: 6px, font-size: 14px } }
KeybindField.keybind { resting: { pad: 6px, font-size: 14px } }
Split.split { resting: { fg: #3d3d3d } }
Panel.panel { resting: { bg: color.panel, border: 1px solid color.outline, radius: 4px } }
CheckItem.check-item {
  resting: { fg: color.fg, font-size: 13px, radius: 3px }
  hover: { bg: color.hover }
  focus: { border: 1px solid color.accent }
  checked: { fg: color.accent }
  disabled: { opacity: 0.4 }
}
Tooltip { resting: { bg: #1a1a1a, fg: color.fg, font-size: 13px, pad: 6px, radius: 3px, border: 1px solid #3d3d3d } }

// Phase 1 widgets.
Separator.rule { resting: { fg: #3d3d3d, margin: 8px 0px } }
Switch.switch {
  resting: { fg: color.accent, font-size: 14px }
  hover: { fg: color.accent-hover }
  focus: { border: 1px solid color.accent }
  disabled: { opacity: 0.4 }
}
ToggleButton.toggle {
  resting: { bg: color.raised, fg: color.fg, radius: 3px, font-size: 13px, border: 1px solid color.outline }
  hover: { bg: color.hover }
  pressed: { bg: #3f3f3f }
  checked: { bg: color.accent, fg: #ffffff }
  focus: { border: 1px solid color.accent }
  disabled: { opacity: 0.4 }
}
RadioGroup.radio {
  resting: { fg: color.accent, font-size: 14px }
  hover: { fg: color.accent-hover }
  focus: { border: 1px solid color.accent }
  disabled: { opacity: 0.4 }
}
NumberField.number {
  resting: { bg: color.raised, fg: color.fg, border: 1px solid color.outline, radius: 3px, pad: 8px, font-size: 14px }
  hover: { bg: color.hover }
  focus: { border: 1px solid color.accent }
  readonly: { bg: #3a3a3a, fg: #b8b8b8 }
  disabled: { opacity: 0.4 }
}
SearchField.search {
  resting: { bg: color.raised, fg: color.fg, border: 1px solid color.outline, radius: 3px, pad: 8px, font-size: 14px }
  hover: { bg: color.hover }
  focus: { border: 1px solid color.accent }
  placeholder: { fg: #8d8d8d }
  disabled: { opacity: 0.4 }
}
Label.demo-label { resting: { fg: color.fg, font-size: 14px } }
Badge.badge { resting: { bg: color.accent, fg: #ffffff, radius: 3px, font-size: 12px, align: Center } }
Spinner.spinner { resting: { fg: color.accent } disabled: { opacity: 0.4 } }
Image.demo-image { resting: { radius: 3px } }

// Second-wave widgets.
SegmentedControl.segmented {
  resting: { fg: color.fg, font-size: 13px }
  hover: { fg: color.fg }
  focus: { border: 1px solid color.accent }
  disabled: { opacity: 0.4 }
}
Rating.rating { resting: { fg: color.accent } hover: { fg: color.accent-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.4 } }
Stepper.stepper { resting: { bg: color.raised, fg: color.fg, border: 1px solid color.outline, radius: 3px, font-size: 14px } hover: { bg: color.hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.4 } }
Breadcrumb.crumbs { resting: { fg: color.fg, font-size: 13px } hover: { fg: #ffffff } focus: { border: 1px solid color.accent } disabled: { opacity: 0.4 } }

ScrollView.scroll-demo {
  resting: { bg: #242424, border: 1px solid color.outline, radius: 5px, pad: 8px, scroll-track: #171717, scroll-thumb: #777777, scrollbar-size: 12px, scrollbar-visibility: always, scroll-behavior: smooth, scroll-speed: 42 }
  hover: { scroll-thumb: #9a9a9a }
  pressed: { scroll-thumb: color.accent }
  focus: { border: 1px solid color.accent }
}
ScrollView.scroll-hidden { resting: { scrollbar-visibility: never } }
Text.scroll-item { resting: { fg: color.fg, bg: #393939, pad: 6px, radius: 3px, margin: 0px 0px 4px } }
Button.scroll-action { resting: { bg: color.raised, fg: color.fg, radius: 3px, pad: 6px, margin: 0px 0px 4px } hover: { bg: color.hover } pressed: { bg: color.accent } }
