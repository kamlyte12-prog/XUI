// One restrained theme and a 4/8/12/16/24 spacing rhythm for the complete showcase.
tokens {
  color.canvas = #101827
  color.surface = #172235
  color.surface-raised = #202f46
  color.surface-hover = #293d59
  color.surface-pressed = #142033
  color.text = #edf3fb
  color.muted = #a6b5c9
  color.placeholder = #8496ae
  color.accent = #69a7ff
  color.accent-hover = #91bdff
  color.outline = #33465f
  color.outline-soft = #415875
  color.disabled = #73839a
  color.readout = #d6e8ff
}

Window { resting: { bg: color.canvas, fg: color.text, font-size: 14px } }
Column.app { resting: { gap: 12px, pad: 18px } }
Row.masthead { resting: { gap: 16px, align: Center, justify: SpaceBetween } }
Text.title { resting: { fg: color.text, font-size: 25px, font-weight: 700 } }
Text.subtitle { resting: { fg: color.muted, font-size: 13px } }
Text.section-title { resting: { fg: color.text, font-size: 17px, font-weight: 650, margin: 4px 0px 2px } }
Text.help { resting: { fg: color.muted, font-size: 13px } }
Text.body-copy { resting: { fg: color.muted, font-size: 13px, margin: 0px 0px 4px } }
Text.field-label { resting: { fg: color.text, font-size: 13px, font-weight: 600 } }
Text.value-caption { resting: { fg: color.muted, font-size: 13px, align: Center } }
Text.value-readout { resting: { bg: color.surface-raised, fg: color.readout, font-size: 13px, pad: 7px, border: 1px solid color.outline, radius: 6px } }
Text.card-label { resting: { fg: color.text, font-size: 13px, align: Center } }
Text.panel-title { resting: { fg: color.text, font-size: 15px, font-weight: 650, margin: 0px 0px 6px } }

Tabs.tabs { resting: { bg: color.surface, border: 1px solid color.outline, radius: 8px } focus: { border: 1px solid color.accent } }
Tab {
  resting: { bg: color.canvas, fg: color.muted, font-size: 13px }
  hover: { bg: color.surface-hover, fg: color.text }
  selected: { bg: color.surface, fg: color.accent, border: 1px solid color.accent }
  disabled: { opacity: 0.42 }
}
ScrollView.page-scroll { resting: { bg: color.surface, border: 1px solid color.outline, radius: 8px, pad: 1px, scrollbar-size: 10px, scrollbar-visibility: auto, scroll-behavior: smooth, scroll-speed: 42, scroll-track: color.canvas, scroll-thumb: #405773 } hover: { scroll-thumb: #587493 } pressed: { scroll-thumb: color.accent } }
Column.page { resting: { bg: color.surface, pad: 16px, gap: 12px, border: 1px solid color.outline, radius: 8px } }
Panel.demo-panel { resting: { bg: color.surface-raised, fg: color.text, pad: 12px, border: 1px solid color.outline-soft, radius: 8px } }
Panel.sizing-card { resting: { bg: color.surface-raised, border: 1px solid color.outline-soft, radius: 7px, pad: 8px } }
Panel.min-card { resting: { min-size: 220px 64px } }
Panel.style-floor { resting: { size: 170px 64px, min-size: 200px 64px, bg: #243956 } }
Panel.clamp-card { resting: { max-width: 230px, border: 1px solid color.accent } }
Panel.nested-panel { resting: { min-size: 180px 90px, pad: 12px } }
Panel.vertical-pane { resting: { min-size: 120px 56px, pad: 8px } }
Panel.pane-left { resting: { min-width: 190px } }
Panel.pane-right { resting: { min-width: 190px } }
Split.split { resting: { fg: color.outline-soft, gap: 0px } }
Split.layout-split { resting: { min-size: 420px 138px } }
Row { resting: { gap: 8px } }
Column { resting: { gap: 8px } }
Row.masthead { resting: { gap: 16px } }
Column.app { resting: { gap: 12px } }
Column.page { resting: { gap: 12px } }
Panel.range-panel { resting: { gap: 12px } }
Column.readouts { resting: { gap: 8px } }

Button.primary-button, Button.secondary-button, Button.small-button {
  resting: { bg: color.surface-raised, fg: color.text, pad: 7px, border: 1px solid color.outline-soft, radius: 6px, font-size: 13px }
  hover: { bg: color.surface-hover, border: 1px solid color.accent }
  pressed: { bg: color.surface-pressed }
  focus: { border: 1px solid color.accent }
  disabled: { bg: color.surface, fg: color.disabled, opacity: 0.48 }
}
Button.primary-button { resting: { bg: #2868b8, fg: #ffffff, border: 1px solid color.accent } hover: { bg: #347acb } pressed: { bg: #1d4e8c } }
Button.small-button { resting: { pad: 5px, font-size: 12px } }

TextBox.field, TextArea.field, SearchField.field, NumberField.field, KeybindField.field {
  resting: { bg: color.surface-raised, fg: color.text, pad: 8px, border: 1px solid color.outline-soft, radius: 6px, font-size: 14px }
  hover: { bg: color.surface-hover }
  focus: { bg: #1c304b, border: 1px solid color.accent }
  placeholder: { fg: color.placeholder }
  readonly: { bg: color.surface, fg: color.muted }
  disabled: { opacity: 0.46 }
}
TextArea.textarea { resting: { pad: 10px } }
TextBox.number { resting: { size: 240px 40px } }
TextBox.keybind { resting: { size: 190px 40px } }

CheckBox.checkbox, CheckItem.check-item {
  resting: { bg: color.surface-raised, fg: color.text, pad: 6px, border: 1px solid color.outline-soft, radius: 5px, font-size: 13px }
  hover: { bg: color.surface-hover }
  focus: { border: 1px solid color.accent }
  checked: { fg: color.accent }
  disabled: { fg: color.disabled, opacity: 0.48 }
}
Switch.switch, RadioGroup.radio-group { resting: { fg: color.accent, font-size: 14px } hover: { fg: color.accent-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.48 } }
ToggleButton.toggle { resting: { bg: color.surface-raised, fg: color.text, pad: 7px, border: 1px solid color.outline-soft, radius: 6px } hover: { bg: color.surface-hover } pressed: { bg: color.surface-pressed } checked: { bg: color.accent, fg: color.canvas } focus: { border: 1px solid color.accent } disabled: { opacity: 0.48 } }
SegmentedControl.segmented { resting: { bg: color.surface-raised, fg: color.text, border: 1px solid color.outline-soft, radius: 6px, pad: 6px } hover: { fg: color.accent-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.48 } }

Slider.slider { resting: { bg: color.outline, fg: color.accent } hover: { fg: color.accent-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.42 } }
ProgressBar.progress { resting: { bg: color.outline, fg: color.accent, radius: 5px } }
Rating.rating { resting: { fg: color.accent } hover: { fg: color.accent-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.45 } }
Stepper.stepper { resting: { bg: color.surface-raised, fg: color.text, pad: 6px, border: 1px solid color.outline-soft, radius: 6px } hover: { bg: color.surface-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.45 } }

Dropdown.popup-control, ColorPicker.popup-control, DatePicker.popup-control { resting: { bg: color.surface-raised, fg: color.text, pad: 8px, border: 1px solid color.outline-soft, radius: 6px } hover: { bg: color.surface-hover } focus: { border: 1px solid color.accent } open: { border: 1px solid color.accent } disabled: { opacity: 0.45 } }
ColorPicker.color-picker { resting: { size: 100% 40px } }
Tooltip { resting: { bg: color.surface-raised, fg: color.text, font-size: 13px, pad: 8px, border: 1px solid color.accent, radius: 6px } }
Breadcrumb.breadcrumb { resting: { fg: color.text, font-size: 13px } hover: { fg: color.accent-hover } focus: { border: 1px solid color.accent } disabled: { opacity: 0.45 } }

Image.demo-image { resting: { bg: color.surface-raised, border: 1px solid color.outline-soft, radius: 8px } }
Label.inline-label, Label.chrome-label { resting: { fg: color.text, font-size: 13px } }
Badge.badge { resting: { bg: color.accent, fg: color.canvas, pad: 5px, radius: 5px, font-size: 11px, font-weight: 650, align: Center } }
Spinner.spinner { resting: { fg: color.accent } disabled: { fg: color.disabled, opacity: 0.42 } }
FpsCounter.fps { resting: { bg: color.surface-raised, fg: color.text, font-size: 12px, pad: 6px, border: 1px solid color.outline, radius: 6px } }
Toolbar.chrome, StatusBar.chrome { resting: { bg: color.surface-raised, fg: color.text, pad: 6px 8px, border: 1px solid color.outline, radius: 6px, gap: 8px, align: Center } }
Separator.separator, Divider.divider { resting: { fg: color.outline-soft, margin: 3px 0px } }
ScrollView.scroll-demo, ScrollView.horizontal-demo { resting: { bg: color.canvas, border: 1px solid color.outline, radius: 6px, pad: 8px, scrollbar-size: 10px, scrollbar-visibility: always, scroll-track: color.surface, scroll-thumb: #405773 } hover: { scroll-thumb: #587493 } pressed: { scroll-thumb: color.accent } focus: { border: 1px solid color.accent } }
Text.scroll-item { resting: { bg: color.surface-raised, fg: color.text, pad: 7px, radius: 5px } }

DockHost.docking-host { resting: { bg: color.surface, pad: 4px, border: 1px solid color.outline, radius: 7px, min-size: 520px 300px } }
DockPanel.dock-panel { resting: { bg: color.surface, fg: color.text, pad: 10px, font-size: 13px } }
DockHeader { resting: { bg: color.surface-raised, fg: color.text, pad: 8px, font-size: 13px, font-weight: 600, radius: 4px }
  hover: { bg: color.surface-hover } pressed: { bg: color.surface-pressed } disabled: { opacity: 0.48 } }
DockTab { resting: { bg: color.canvas, fg: color.muted, pad: 8px, font-size: 13px }
  hover: { bg: color.surface-hover, fg: color.text }
  selected: { bg: color.surface-raised, fg: color.accent, border: 1px solid color.accent }
  pressed: { bg: color.surface-pressed } disabled: { opacity: 0.48 } }
DockCloseButton { resting: { fg: color.muted, font-size: 16px, radius: 4px, align: Center }
  hover: { bg: #9c3e52, fg: #ffffff } pressed: { bg: #762f40, fg: #ffffff } disabled: { opacity: 0.4 } }
DockSplitter { resting: { bg: color.outline }
  hover: { bg: color.accent } pressed: { bg: color.accent-hover } dragging: { bg: color.accent-hover } }
DockPreview { resting: { bg: #69a7ff55, border: 1px solid color.accent, radius: 5px }
  dragging: { bg: #69a7ff66 } }
