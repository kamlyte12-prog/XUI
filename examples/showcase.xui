// Reference showcase: every runtime-supported widget and layout option, grouped by category.
// Structure and styling live here and in showcase.xss; glfw_demo.cpp only wires event handlers.
Window(title: "Xui GLFW/OpenGL widget showcase", size: 1080x760) {
  Column[id: "app-column", class: "app", pad: 20px, gap: 10px] {
    Text("Xui widget showcase")[class: "title"]
    Row(gap: 12)[class: "toolbar", width: 100%, height: 28px, align: Center] {
      Text("Every widget and layout option, grouped by category. Press F3 for the FPS overlay.")[class: "subtitle"]
      FpsCounter[class: "fps", width: 168px, height: 26px, pad: 5px]
    }

    Tabs[id: "demo-sections", selected: 0, change: onTabChange, class: "tabs", width: 100%, height: 620px] {

      // ── Layout options: sizing, alignment, spacing, nesting ────────────────────────────
      Tab(title: "Layout") {
        Column[class: "page", pad: 18px, gap: 10px, grow: 1] {
          Text("Sizing: fixed, percent, and min/max floors")[class: "section-title"]
          Text("Middle box is 30% of the row. The right box grows but never shrinks below its 220x64 floor (minSize) — shrink the window and it holds.")[class: "help"]
          Row(gap: 12)[width: 100%] {
            Panel[id: "sizing-fixed", class: "layout-box", width: 120px, height: 64px] { Text("120px fixed")[class: "help"] }
            Panel[id: "sizing-pct", class: "layout-box", width: 30%, height: 64px] { Text("30% of parent")[class: "help"] }
            Panel[id: "sizing-min", class: "layout-box", grow: 1, height: 64px, minSize: 220x64] { Text("grow: 1, minSize 220x64")[class: "help"] }
          }
          Separator[class: "rule"]
          Text("Direction, alignment, and spacing")[class: "section-title"]
          Column[class: "layout-box", width: 100%, pad: 10px, gap: 8px, align: Center] {
            Row(gap: 8)[width: 100%, justify: SpaceBetween] {
              Text("justify: SpaceBetween")[class: "help"]
              Text("start")[class: "help"]
              Text("end")[class: "help"]
            }
            Row(gap: 8)[width: 100%, justify: Center] {
              Button(label: "Centered")[class: "secondary", width: 120px, height: 30px]
              Button(label: "in a centered row", disabled: true)[class: "secondary", width: 150px, height: 30px]
            }
          }
          Separator[class: "rule"]
          Text("Nesting and margins")[class: "section-title"]
          Panel[class: "layout-box", width: 100%, pad: 12px] {
            Panel[class: "layout-box P2", width: 100%, pad: 10px] {
              Text("Outer panel pads 12; the inner panel adds a 24px left margin — nesting composes insets.")[class: "help"]
            }
          }
        }
      }

      // ── Text entry: single-line, password, read-only, multiline, numeric ───────────────
      Tab(title: "Input") {
        Column[class: "page", pad: 18px, gap: 10px, grow: 1] {
          Text("Text entry")[class: "section-title"]
          Row(gap: 12)[width: 100%] {
            TextBox[id: "display-name", value: "Guest", placeholder: "Display name", maxLength: 48,
                   tooltip: "Single-line input. Try Shift+arrows, Ctrl+A/C/X/V, Delete, and Backspace.",
                   tooltipTrigger: "both", tooltipShowDelay: 450, tooltipHideDelay: 120,
                   change: onNameChange, class: "field name-field", width: 380px, height: 40px]
            TextBox[id: "passphrase", password: true, placeholder: "Password", maxLength: 32,
                   tooltip: "Password mode masks the display with bullets; the stored text is plain.",
                   change: onPassphraseChange, class: "field", width: 170px, height: 40px]
            TextBox[id: "readonly-field", value: "Read only", readOnly: true,
                   tooltip: "This tip is disabled for this field.", tooltipDisabled: true,
                   class: "field readonly-field", width: 200px, height: 40px]
          }
          TextArea[id: "notes", value: "", placeholder: "Write a multiline note…", maxLength: 800, tabSize: 4,
                   tooltip: "Text wraps inside this area. Enter adds a line; Tab inserts four spaces.",
                   change: onNotesChange, class: "field notes", width: 720px, height: 120px, align: Start]
          Row(gap: 12)[width: 100%] {
            SearchField[id: "query", placeholder: "Search widgets…", maxLength: 60,
                   tooltip: "Click the x glyph or press Escape to clear. The string is readable by id.",
                   change: onSearchChange, class: "search", width: 440px, height: 40px]
            Text("(empty)")[id: "search-readout", class: "value-readout", width: 260px, height: 24px]
          }
          Row(gap: 12)[width: 100%] {
            NumberField[id: "delay", value: 250, min: 0, max: 2000, step: 50, unit: "ms", precision: 0,
                   tooltip: "Type a number, use the steppers, or focus and press Up/Down. Clamped to min/max.",
                   change: onNumberChange, class: "number", width: 220px, height: 40px]
            Text("Delay: 250 ms")[id: "number-readout", class: "value-readout", width: 320px, height: 24px]
          }
          Row(gap: 12)[width: 100%] {
            KeybindField[id: "save-key", value: "Ctrl+S", placeholder: "Press keys…",
                   tooltip: "Focus and press a key combination. Escape clears it.",
                   change: onKeybindChange, class: "keybind", width: 170px, height: 34px]
            Text("Save key: Ctrl+S")[id: "keybind-readout", class: "value-readout", width: 320px, height: 24px]
          }
          CheckBox(label: "Show whitespace marks")[id: "whitespace-toggle", checked: false,
                  tooltip: "Render spaces as a middle dot and tabs as a right arrow in the fields above.",
                  change: onWhitespaceToggle, class: "checkbox", width: 300px, height: 34px, pad: 5px]
        }
      }

      // ── Buttons, toggles, choices, and values ──────────────────────────────────────────
      Tab(title: "Controls") {
        Column[class: "page", pad: 18px, gap: 10px, grow: 1] {
          Text("Buttons, toggles, and values")[class: "section-title"]
          Text("Hover, focus, press, and disable. Every value widget mirrors its state into a readout.")[class: "help"]
          Row(gap: 12)[width: 100%] {
            Button(label: "Run action")[id: "run-action", tooltip: "Activate the demo action.", press: onAction, class: "action", width: 220px, height: 42px]
            Button(label: "Disabled action")[disabled: true, class: "action disabled-action", width: 220px, height: 42px]
            CheckBox(label: "Receive updates")[id: "updates", checked: true,
                    tooltip: "Checkbox state is available as a bool by id.", change: onCheckChange, class: "checkbox", width: 250px, height: 42px, pad: 6px]
          }
          Row(gap: 12)[width: 100%] {
            Switch[label: "Live sync", checked: true, tooltip: "Switch state is a bool by id.",
                   id: "live-sync", change: onSwitchChange, class: "switch", width: 220px, height: 36px]
            ToggleButton(label: "Mute")[id: "mute", checked: false, tooltip: "A button that stays pressed.",
                   change: onToggleChange, class: "toggle", width: 150px, height: 36px]
            SegmentedControl[id: "shading", options: "Solid|Wireframe|Rendered", value: "Solid",
                   tooltip: "Click a segment, or focus and press Left/Right.", change: onShadingChange,
                   class: "segmented", width: 330px, height: 30px]
          }
          Row(gap: 16)[width: 100%] {
            RadioGroup[id: "density-choice", options: "Compact|Comfortable|Spacious", value: "Comfortable",
                   tooltip: "Click a row or focus and press Up/Down.",
                   change: onRadioChange, class: "radio", width: 300px, height: 108px]
            Column(gap: 8)[class: "readouts"] {
              Text("Live sync: on")[id: "switch-readout", class: "value-readout", width: 240px, height: 22px]
              Text("Mute: off")[id: "toggle-readout", class: "value-readout", width: 240px, height: 22px]
              Text("Layout: Comfortable")[id: "radio-readout", class: "value-readout", width: 240px, height: 22px]
              Text("Shading: Solid")[id: "shading-readout", class: "value-readout", width: 240px, height: 22px]
            }
          }
          Separator[class: "rule"]
          Text("Ranges")[class: "section-title"]
          Row(gap: 12)[width: 100%, align: Center] {
            Slider[id: "volume", value: 0.65, min: 0, max: 1, tooltip: "Drag the thumb or focus and press Left/Right.",
                   change: onSliderChange, class: "slider", width: 480px, height: 26px]
            Text("Volume: 65%")[id: "volume-readout", class: "value-readout", width: 160px, height: 24px]
          }
          Row(gap: 12)[width: 100%, align: Center] {
            ProgressBar[id: "progress-demo", value: 0.65, min: 0, max: 1, class: "progress", width: 480px, height: 16px]
            Text("65% determinate")[class: "help", width: 160px, height: 16px]
          }
          Row(gap: 12)[width: 100%, align: Center] {
            ProgressBar[id: "busy-bar", indeterminate: true, class: "progress", width: 480px, height: 14px]
            Text("indeterminate")[class: "help", width: 160px, height: 14px]
          }
          Row(gap: 12)[width: 100%, align: Center] {
            Rating[id: "priority", value: 3, max: 5, tooltip: "Click a pip; click the last lit pip to clear.",
                   change: onRatingChange, class: "rating", width: 130px, height: 24px]
            Text("Priority: 3/5")[id: "rating-readout", class: "value-readout", width: 160px, height: 24px]
            Stepper[id: "subdivisions", value: 2, min: 0, max: 7, step: 1, change: onSubdivChange,
                   tooltip: "Click - or +, or focus and press Up/Down.", class: "stepper", width: 180px, height: 34px]
            Text("Subdivisions: 2")[id: "subdiv-readout", class: "value-readout", width: 160px, height: 24px]
          }
        }
      }

      // ── Popup controls ─────────────────────────────────────────────────────────────────
      Tab(title: "Pickers") {
        Column[class: "page", pad: 18px, gap: 10px, grow: 1] {
          Text("Popup controls")[class: "section-title"]
          Text("Open, choose, and close: dropdown list, HSV picker, month calendar, key capture.")[class: "help"]
          Row(gap: 12)[width: 100%] {
            Dropdown[id: "density", options: "Compact|Comfortable|Spacious", value: "Comfortable",
                     tooltip: "Click to open; choose one density.", tooltipTrigger: "hover", tooltipShowDelay: 350,
                     change: onDensityChange, class: "dropdown", width: 260px, height: 38px, pad: 8px]
            Text("Density: Comfortable")[class: "help", width: 240px, height: 24px]
          }
          Row(gap: 12)[width: 100%] {
            ColorPicker[id: "accent-color", value: #5b8cff, format: "hex", formats: "hex|rgb|hsl|hsv", precision: 1,
                        popupSize: 300x352, alpha: true, showAlpha: true, showInputs: true,
                        showFormatSwitcher: true, showHue: true, showSaturationValue: true,
                        tooltip: "Click and drag in the popup, switch formats, or edit the value row.",
                        change: onColorChange, class: "color-picker", width: 260px, height: 38px, pad: 8px]
            Text("Pick a color; the popup reports live changes.")[class: "help", width: 300px, height: 24px]
          }
          Row(gap: 12)[width: 100%] {
            DatePicker[id: "due-date", value: "2026-10-15", change: onDateChange,
                  tooltip: "Click to open the calendar; arrows move the day while it is open.",
                  class: "date", width: 170px, height: 34px]
            KeybindField[id: "save-key", value: "Ctrl+S", placeholder: "Press keys…",
                  tooltip: "Focus and press a key combination. Escape clears it.",
                  change: onKeybindChange, class: "keybind", width: 170px, height: 34px]
            Text("Due: 2026-10-15")[id: "date-readout", class: "value-readout", width: 220px, height: 24px]
            Text("Save key: Ctrl+S")[id: "keybind-readout", class: "value-readout", width: 220px, height: 24px]
          }
          Separator[class: "rule"]
          Text("Breadcrumb")[class: "section-title"]
          Breadcrumb[id: "trail", options: "Project|Assets|Textures|Wood", value: "Textures",
                tooltip: "Click a path segment to navigate there.", change: onTrailChange,
                class: "crumbs", width: 420px, height: 24px]
          Text("Trail: Project › Assets › Textures")[id: "trail-readout", class: "value-readout", width: 420px, height: 22px]
        }
      }

      // ── Display widgets and chrome containers ──────────────────────────────────────────
      Tab(title: "Display") {
        Column[class: "page", pad: 18px, gap: 10px, grow: 1] {
          Text("Static content and indicators")[class: "section-title"]
          Row(gap: 14)[width: 100%] {
            Image("xui-demo-image.png")[fit: Contain, tooltip: "PNG loaded through the renderer's texture API.",
                  class: "demo-image", width: 200px, height: 120px]
            Column(gap: 10)[grow: 1] {
              Row(gap: 10) {
                Label("Static label text")[class: "demo-label", width: 200px, height: 22px]
                Badge("NEW")[class: "badge", width: 58px, height: 22px]
                Spinner[class: "spinner", width: 22px, height: 22px]
                Spinner[disabled: true, class: "spinner", width: 22px, height: 22px]
              }
              Toolbar[id: "demo-toolbar", class: "demo-toolbar"] {
                Label("Toolbar")[class: "demo-label"]
                Button(label: "Action")[class: "secondary", width: 96px, height: 32px]
              }
              StatusBar[id: "demo-status", class: "demo-status"] {
                Text("StatusBar")[class: "help"]
                Badge("Ready")[class: "badge", width: 64px, height: 22px]
              }
            }
          }
          Separator[class: "rule"]
          Text("Tooltips and the FPS overlay")[class: "section-title"]
          Row(gap: 12)[width: 100%, align: Center] {
            Button(label: "Tooltip target")[tooltip: "This tooltip is attached to its target control.",
                   press: onAction, class: "secondary", width: 220px, height: 40px]
            Text("Hover the button; it hides on click.")[class: "help", width: 300px, height: 24px]
          }
          Row(gap: 12)[width: 100%, align: Center] {
            FpsCounter[class: "fps", width: 168px, height: 26px, pad: 5px]
            Text("F3 toggles the overlay anywhere in the demo.")[class: "help", width: 340px, height: 24px]
          }
        }
      }

      // ── Scrolling, splitters, and checklists ───────────────────────────────────────────
      Tab(title: "Containers") {
        Column[class: "page", pad: 18px, gap: 10px, grow: 1] {
          Text("Scrolling, splitters, and checklists")[class: "section-title"]
          Text("Wheel or drag the scrollbars, drag the splitter, toggle the checklist.")[class: "help"]
          Row(gap: 12)[width: 100%, grow: 1] {
            Column(gap: 8)[width: 460px] {
              ScrollView[id: "vertical-scroll", vertical: true, horizontal: false, scrollBehavior: "smooth", scrollSpeed: 42,
                         class: "scroll-demo", width: 100%, height: 180px, change: onScrollChanged] {
                Column(gap: 4)[id: "vertical-content"] {
                  Text("Vertical content")[class: "panel-title"]
                  Button(label: "Scroll target A")[id: "scroll-target-a", class: "scroll-action", width: 180px, height: 32px]
                  Text("Item 02 — retained layout")[class: "scroll-item"]
                  Text("Item 03 — clipped at viewport")[class: "scroll-item"]
                  Text("Item 04 — wheel and keyboard")[class: "scroll-item"]
                  Text("Item 05 — scrollbar drag")[class: "scroll-item"]
                  Text("Item 06 — nested containers")[class: "scroll-item"]
                  Text("Item 07 — focus navigation")[class: "scroll-item"]
                  Text("Item 08 — no forced reflow")[class: "scroll-item"]
                  Text("Item 11 — last visible target")[id: "scroll-target-last", class: "scroll-item"]
                }
              }
              ScrollView[id: "horizontal-scroll", horizontal: true, vertical: false, scrollbar: "always",
                         class: "scroll-demo", width: 100%, height: 96px, change: onScrollChanged] {
                Row(gap: 12)[id: "horizontal-content"] {
                  Button(label: "Horizontal 1")[class: "scroll-action", width: 180px, height: 56px]
                  Button(label: "Horizontal 2")[class: "scroll-action", width: 180px, height: 56px]
                  Button(label: "Horizontal 3")[class: "scroll-action", width: 180px, height: 56px]
                  Button(label: "Horizontal 4")[class: "scroll-action", width: 180px, height: 56px]
                  Button(label: "Horizontal 5")[class: "scroll-action", width: 180px, height: 56px]
                }
              }
              Row(gap: 12)[width: 100%, align: Center] {
                Button(label: "Scroll to last item")[press: onScrollToTarget, class: "action", width: 210px, height: 36px]
                Text("Vertical offset: 0, 0")[id: "scroll-position-readout", class: "value-readout", width: 220px, height: 24px]
              }
            }
            Split(direction: Horizontal)[id: "main-split", class: "split", ratio: 0.34, gutter: 8, grow: 1] {
              Panel[id: "tasks-panel", class: "panel checklist-panel", pad: 12px] {
                Text("Tasks")[class: "panel-title"]
                CheckList[gap: 6, class: "checklist"] {
                  CheckItem(label: "Parse the .xui tree", checked: true)[id: "task-layout", change: onTaskLayout, class: "check-item", width: 100%, height: 34px, pad: 5px]
                  CheckItem(label: "Resolve .xss styles", checked: true)[id: "task-styles", change: onTaskStyles, class: "check-item", width: 100%, height: 34px, pad: 5px]
                  CheckItem(label: "Keep controls backend-neutral")[id: "task-backend", change: onTaskBackend, class: "check-item", width: 100%, height: 34px, pad: 5px]
                  CheckItem(label: "Resize the split panels")[id: "task-resize", change: onTaskResize, class: "check-item", width: 100%, height: 34px, pad: 5px]
                }
              }
              Panel[id: "content-panel", class: "panel content-panel", pad: 12px] {
                Text("Shared document, replaceable backends")[class: "panel-title"]
                Text("This page is described entirely with .xui structure and .xss styling. The GLFW platform supplies window and input events; the OpenGL renderer draws the same backend-neutral command list.")[class: "body"]
                Text("Long content wraps to the next line, contributes to auto layout, and is clipped to the widget bounds instead of painting over neighboring controls.")[class: "body"]
                Button(label: "Test hover and focus")[tooltip: "This tooltip is attached to its target control.", press: onAction, class: "secondary", width: 240px, height: 40px]
              }
            }
          }
        }
      }
    }
  }
}
