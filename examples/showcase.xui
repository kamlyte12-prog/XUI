// Full interactive reference. Layout/content belong here; visual rules live in showcase.xss.
Window(title: "Xui widget and layout showcase", size: 1080x760) {
  Column[class: "app", width: 100%, height: 100%, pad: 18px, gap: 12px] {
    Row(gap: 16)[class: "masthead", width: 100%, align: Center, justify: SpaceBetween] {
      Column(gap: 3px)[grow: 1] {
        Text("Xui interactive showcase")[class: "title"]
        Text("Explore layout, inputs, selection, ranges, popups, and containers. Resize the window; press F3 for FPS.")[class: "subtitle"]
      }
      Text("Section 1")[id: "tab-readout", class: "value-readout", width: 110px, height: 30px]
      FpsCounter[id: "fps", class: "fps", width: 150px, height: 30px]
    }

    Tabs[id: "demo-sections", selected: 0, change: onTabChange, class: "tabs", width: 100%, height: 100%, grow: 1, minSize: 0x0] {
      // 1. Layout systems: fixed/percent/auto, min/max, flex, alignment, spacing, and nesting.
      Tab(title: "Layout") {
        ScrollView[class: "page-scroll", width: 100%, height: 100%, vertical: true, horizontal: false] {
          Column[class: "page", gap: 14px, pad: 18px, minSize: 0x0] {
            Text("Sizing constraints")[class: "section-title"]
            Text("Compare fixed, percentage, clamped, and content-sized panels. Shrink the window to see explicit minimums hold; scroll horizontally if their combined width exceeds the viewport.")[class: "help"]
            ScrollView[id: "sizing-scroll", class: "horizontal-demo", width: 100%, height: 104px, horizontal: true, vertical: false, scrollbar: "always"] {
              Row(gap: 10)[width: 1180px, height: 76px, align: Center] {
                Panel[id: "sizing-fixed", class: "sizing-card", width: 150px, height: 64px] { Text("Fixed\n150 × 64")[class: "card-label"] }
                Panel[id: "sizing-pct", class: "sizing-card", width: 28%, height: 64px] { Text("28% width")[class: "card-label"] }
                Panel[id: "sizing-min", class: "sizing-card min-card", grow: 1, height: 64px, minSize: 220x64] { Text("XUI minSize\n220 × 64")[class: "card-label"] }
                Panel[id: "style-floor", class: "sizing-card style-floor", width: 170px, height: 64px] { Text("XSS min-size\n200 × 64")[class: "card-label"] }
                Panel[id: "sizing-clamp", class: "sizing-card clamp-card", width: 70%, minWidth: 180px, maxWidth: 230px, height: 64px] { Text("70%, min 180, max 230")[class: "card-label"] }
              }
            }

            Text("Flow, alignment, and distribution")[class: "section-title"]
            Panel[class: "demo-panel", width: 100%, pad: 12px, minSize: 0x108] {
              Column(gap: 12px)[width: 100%] {
                Row(gap: 8)[width: 100%, align: Center, justify: SpaceBetween] {
                  Text("Row + SpaceBetween")[class: "value-readout"]
                  Button(label: "Start")[class: "small-button", width: 88px, height: 32px]
                  Button(label: "End")[class: "small-button", width: 88px, height: 32px]
                }
                Row(gap: 8)[width: 100%, align: Center, justify: Center] {
                  Button(label: "Centered")[class: "small-button", width: 110px, height: 32px]
                  Button(label: "Disabled", disabled: true)[class: "small-button", width: 110px, height: 32px]
                }
                Column(gap: 6px)[width: 100%, align: Start] {
                  Text("Column + Start alignment")[class: "help"]
                  Text("Nested rows and columns use gap, padding, and margins.")[class: "body-copy"]
                }
              }
            }

            Text("Flow and anchored positioning")[class: "section-title"]
            Text("The tag is absolutely positioned at the panel's top-right inset; the text remains in normal column flow with reserved width, so the two do not overlap.")[class: "help"]
            Panel[id: "position-box", class: "demo-panel position-box", width: 100%, height: 82px, pad: 10px] {
              Text("Flow text stays in its column.")[id: "position-label", class: "body-copy", width: 65%, height: 28px]
              Text("The anchored tag uses top/right offsets.")[class: "help", width: 65%, height: 24px]
              Badge("TOP-RIGHT")[id: "position-tag", class: "badge", position: Absolute, top: 12px, right: 12px, width: 96px, height: 26px]
            }

            Text("Nested containers and resizable split panes")[class: "section-title"]
            Text("The outer panel has padding; the inner panel has an authored XSS minimum. Drag the splitter. The left pane has an explicit minimum width.")[class: "help"]
            Split(direction: Horizontal)[id: "layout-split", class: "split layout-split", ratio: 0.42, gutter: 8, width: 100%, height: 138px, minSize: 420x138] {
              Panel[id: "nested-left", class: "demo-panel nested-panel", minSize: 180x90] {
                Text("Nested panel")[class: "panel-title"]
                Text("Minimums apply to containers as well as leaf widgets.")[class: "body-copy"]
              }
              Panel[id: "nested-right", class: "demo-panel nested-panel", minSize: 180x90] {
                Text("Sibling pane")[class: "panel-title"]
                Text("This Split remains draggable while respecting both pane floors.")[class: "body-copy"]
              }
            }
            Text("Vertical Split direction")[class: "section-title"]
            Split(direction: Vertical)[id: "vertical-split", class: "split vertical-split", ratio: 0.5, gutter: 6, width: 100%, height: 132px, minSize: 320x132] {
              Panel[id: "vertical-top", class: "demo-panel vertical-pane", minSize: 120x56] { Text("Top pane")[class: "body-copy"] }
              Panel[id: "vertical-bottom", class: "demo-panel vertical-pane", minSize: 120x56] { Text("Bottom pane")[class: "body-copy"] }
            }
            Text("Insets: the surrounding cards demonstrate padding, margins, borders, and nested content bounds.")[class: "help inset-note"]
          }
        }
      }

      // 2. Editable fields: focus, typing, deletion, multiline wrapping, read-only, and disabled states.
      Tab(title: "Text input") {
        ScrollView[class: "page-scroll", width: 100%, height: 100%, vertical: true, horizontal: false] {
          Column[class: "page", gap: 12px, pad: 18px] {
            Text("Text entry and editing")[class: "section-title"]
            Text("Click a field to focus it. Try typing, selection, Backspace/Delete, clipboard shortcuts, and Tab in the multiline field.")[class: "help"]
            Row(id: "input-row", gap: 10)[width: 100%, align: Center] {
              Column(gap: 5px)[grow: 1] {
                Text("Display name")[class: "field-label"]
                TextBox[id: "display-name", value: "Guest", placeholder: "Display name", maxLength: 48, tooltip: "Single-line text, live value shown below.", change: onNameChange, class: "field", width: 100%, height: 40px]
              }
              Column(gap: 5px)[width: 190px] {
                Text("Password mode")[class: "field-label"]
                TextBox[id: "passphrase", password: true, placeholder: "Password", maxLength: 32, change: onPassphraseChange, class: "field", width: 100%, height: 40px]
              }
              Column(gap: 5px)[width: 190px] {
                Text("Read-only")[class: "field-label"]
                TextBox[id: "readonly-field", value: "Cannot edit", readOnly: true, class: "field readonly", width: 100%, height: 40px]
              }
            }
            Row(gap: 8)[width: 100%] {
              Text("Name value:")[class: "value-caption", width: 106px, height: 30px]
              Text("Guest")[id: "name-readout", class: "value-readout", grow: 1, height: 30px]
              Text("Password length: 0")[id: "password-readout", class: "value-readout", width: 220px, height: 30px]
            }
            Text("Multiline notes")[class: "field-label"]
            TextArea[id: "notes", value: "", placeholder: "Write a multiline note…", maxLength: 800, tabSize: 4, tooltip: "Text wraps; Enter inserts a line and Tab inserts four spaces.", change: onNotesChange, class: "field textarea", width: 100%, height: 132px, align: Start]
            Row(gap: 8)[width: 100%] {
              Text("Notes value:")[class: "value-caption", width: 106px, height: 30px]
              Text("(empty)")[id: "notes-readout", class: "value-readout", grow: 1, minHeight: 30px]
              CheckBox(label: "Show whitespace")[id: "whitespace-toggle", checked: false, change: onWhitespaceToggle, class: "checkbox", width: 190px, height: 34px]
            }
            Text("Search and numeric entry")[class: "section-title"]
            Row(gap: 10)[width: 100%, align: Center] {
              SearchField[id: "query", placeholder: "Search widgets…", maxLength: 60, change: onSearchChange, class: "field", grow: 1, height: 40px]
              Text("(empty)")[id: "search-readout", class: "value-readout", width: 260px, height: 32px]
            }
            Row(gap: 10)[width: 100%, align: Center] {
              NumberField[id: "delay", value: 250, min: 0, max: 2000, step: 50, unit: "ms", precision: 0, change: onNumberChange, class: "field number", width: 240px, height: 40px]
              Text("Delay: 250 ms")[id: "number-readout", class: "value-readout", width: 260px, height: 32px]
              KeybindField[id: "save-key", value: "Ctrl+S", placeholder: "Press keys…", change: onKeybindChange, class: "field keybind", width: 190px, height: 40px]
              Text("Save key: Ctrl+S")[id: "keybind-readout", class: "value-readout", grow: 1, height: 32px]
            }
          }
        }
      }

      // 3. Selection controls: hover/focus/pressed/checked/disabled and value reflection.
      Tab(title: "Choices") {
        ScrollView[class: "page-scroll", width: 100%, height: 100%, vertical: true, horizontal: false] {
          Column[class: "page", gap: 12px, pad: 18px] {
            Text("Buttons and boolean controls")[class: "section-title"]
            Row(gap: 10)[width: 100%, align: Center] {
              Button(label: "Run action")[id: "run-action", press: onAction, tooltip: "Hover for a delayed tooltip; press to update the action result.", class: "primary-button", width: 170px, height: 40px]
              Button(label: "Disabled button", disabled: true)[class: "secondary-button", width: 170px, height: 40px]
              Text("Action count: 0")[id: "action-readout", class: "value-readout", grow: 1, height: 32px]
            }
            Row(gap: 10)[width: 100%, align: Center] {
              CheckBox(label: "Receive updates")[id: "updates", checked: true, change: onCheckChange, class: "checkbox", width: 220px, height: 38px]
              Text("Updates: on")[id: "check-readout", class: "value-readout", width: 190px, height: 32px]
              Switch[label: "Live sync", checked: true, id: "live-sync", change: onSwitchChange, class: "switch", width: 190px, height: 38px]
              Text("Live sync: on")[id: "switch-readout", class: "value-readout", width: 180px, height: 32px]
            }
            Row(gap: 10)[width: 100%, align: Center] {
              ToggleButton(label: "Mute")[id: "mute", checked: false, change: onToggleChange, class: "toggle", width: 140px, height: 38px]
              Text("Mute: off")[id: "toggle-readout", class: "value-readout", width: 150px, height: 32px]
              CheckBox(label: "Disabled choice", disabled: true)[id: "disabled-check", class: "checkbox", width: 220px, height: 38px]
            }

            Text("Single and grouped choices")[class: "section-title"]
            Row(gap: 14)[width: 100%, align: Start] {
              Column(gap: 8px)[width: 300px] {
                Text("RadioGroup")[class: "field-label"]
                RadioGroup[id: "density-choice", options: "Compact|Comfortable|Spacious", value: "Comfortable", change: onRadioChange, class: "radio-group", width: 280px, height: 112px]
                Text("Density: Comfortable")[id: "radio-readout", class: "value-readout", width: 280px, height: 30px]
              }
              Column(gap: 8px)[grow: 1] {
                Text("SegmentedControl")[class: "field-label"]
                SegmentedControl[id: "shading", options: "Solid|Wireframe|Rendered", value: "Solid", change: onShadingChange, class: "segmented", width: 100%, height: 38px]
                Text("Shading: Solid")[id: "shading-readout", class: "value-readout", width: 100%, height: 30px]
                Text("CheckItem rows")[class: "field-label"]
              }
            }

            Text("Sliders, progress, rating, and numeric stepping")[class: "section-title"]
            Panel[class: "demo-panel range-panel", width: 100%, pad: 14px] {
              Text("Slider")[class: "field-label"]
              Row(gap: 12)[width: 100%, align: Center] {
                Slider[id: "volume", value: 0.65, min: 0, max: 1, change: onSliderChange, tooltip: "Drag the thumb for immediate updates.", class: "slider", grow: 1, height: 28px]
                Text("Volume: 65%")[id: "volume-readout", class: "value-readout", width: 150px, height: 32px]
              }
              Text("ProgressBar follows the slider value")[class: "field-label"]
              ProgressBar[id: "progress-demo", value: 0.65, min: 0, max: 1, class: "progress", width: 100%, height: 18px]
              Text("Progress: 65%")[id: "progress-readout", class: "value-readout", width: 180px, height: 30px]
              Text("Indeterminate progress animation")[class: "field-label"]
              ProgressBar[id: "busy-bar", indeterminate: true, class: "progress", width: 100%, height: 16px]
            }
            Row(gap: 14)[width: 100%, align: Start] {
              Column(gap: 8px)[grow: 1] {
                Text("Rating")[class: "field-label"]
                Rating[id: "priority", value: 3, max: 5, change: onRatingChange, class: "rating", width: 180px, height: 32px]
                Text("Priority: 3 / 5")[id: "rating-readout", class: "value-readout", width: 180px, height: 30px]
              }
              Column(gap: 8px)[grow: 1] {
                Text("Stepper")[class: "field-label"]
                Stepper[id: "subdivisions", value: 2, min: 0, max: 7, step: 1, change: onSubdivChange, class: "stepper", width: 200px, height: 38px]
                Text("Subdivisions: 2")[id: "subdiv-readout", class: "value-readout", width: 200px, height: 30px]
              }
              Column(gap: 8px)[grow: 1] {
                Text("Disabled slider")[class: "field-label"]
                Slider[value: 0.4, min: 0, max: 1, disabled: true, class: "slider", width: 100%, height: 28px]
                Text("Disabled-state styling")[class: "help"]
              }
            }
            Separator[class: "separator"]
            Divider[class: "divider"]
          }
        }
      }

      // 5. Popup and navigation widgets: open, edit, select, switch, dismiss, and reflect values.
      Tab(title: "Popups") {
        ScrollView[class: "page-scroll", width: 100%, height: 100%, vertical: true, horizontal: false] {
          Column[class: "page", gap: 14px, pad: 18px] {
            Text("Popup controls and navigation")[class: "section-title"]
            Row(gap: 12)[width: 100%, align: Center] {
              Column(gap: 7px)[grow: 1] {
                Text("Dropdown — click to open and choose")[class: "field-label"]
                Dropdown[id: "density", options: "Compact|Comfortable|Spacious", value: "Comfortable", change: onDensityChange, class: "popup-control", width: 100%, height: 40px]
              }
              Text("Density: Comfortable")[id: "density-readout", class: "value-readout", width: 260px, height: 32px]
            }
            Row(gap: 12)[width: 100%, align: Center] {
              Column(gap: 7px)[grow: 1] {
                Text("ColorPicker — open, drag, switch format, edit fields")[class: "field-label"]
                ColorPicker[id: "accent-color", value: #5b8cff, format: "hex", formats: "hex|rgb|hsl|hsv", precision: 1, popupSize: 300x352, alpha: true, showAlpha: true, showInputs: true, showFormatSwitcher: true, showHue: true, showSaturationValue: true, change: onColorChange, class: "popup-control color-picker", width: 100%, height: 40px]
              }
              Text("Accent: #5B8CFFFF")[id: "color-readout", class: "value-readout", width: 260px, height: 32px]
            }
            Row(gap: 12)[width: 100%, align: Center] {
              Column(gap: 7px)[grow: 1] {
                Text("DatePicker — open calendar and choose a date")[class: "field-label"]
                DatePicker[id: "due-date", value: "2026-10-16", change: onDateChange, class: "popup-control", width: 100%, height: 40px]
              }
              Text("Date: 2026-10-16")[id: "date-readout", class: "value-readout", width: 260px, height: 32px]
            }
            Row(gap: 12)[width: 100%, align: Center] {
              Column(gap: 7px)[grow: 1] {
                Text("Breadcrumb — select a path segment")[class: "field-label"]
                Breadcrumb[id: "trail", options: "Project|Assets|Textures|Wood", value: "Textures", change: onTrailChange, class: "breadcrumb", width: 100%, height: 36px]
              }
              Text("Path: Project > Assets > Textures")[id: "trail-readout", class: "value-readout", width: 320px, height: 32px]
            }
            Row(gap: 12)[width: 100%, align: Center] {
              Button(label: "Tooltip target")[tooltip: "Tooltips attach to controls. Move away to hide; focus can also trigger them.", tooltipTrigger: "both", tooltipShowDelay: 400, tooltipHideDelay: 120, class: "secondary-button", width: 220px, height: 40px]
              Text("Hover or focus the button. Escape dismisses an open popup.")[class: "help", grow: 1]
            }
          }
        }
      }

      // 5. Static display leaves and app chrome.
      Tab(title: "Display") {
        ScrollView[class: "page-scroll", width: 100%, height: 100%, vertical: true, horizontal: false] {
          Column[class: "page", gap: 14px, pad: 18px] {
            Text("Labels, badges, images, and indicators")[class: "section-title"]
            Text("These display-oriented leaves share the same layout and theme system. Hover the image for its attached tooltip.")[class: "help"]
            Image("xui-demo-image.png")[id: "demo-image", fit: Contain, tooltip: "Image is loaded through the renderer interface.", class: "demo-image", width: 420px, height: 220px]
            Row(gap: 10)[width: 100%, align: Center] {
              Label("Label text")[class: "inline-label", width: 140px, height: 30px]
              Badge("NEW")[class: "badge", width: 64px, height: 26px]
              Spinner[class: "spinner", width: 24px, height: 24px]
              Spinner[disabled: true, class: "spinner disabled-spinner", width: 24px, height: 24px]
              FpsCounter[class: "fps fps-secondary", width: 150px, height: 30px]
            }
            Toolbar[id: "demo-toolbar", class: "chrome toolbar", width: 100%, height: 42px] {
              Label("Toolbar")[class: "chrome-label"]
              Button(label: "Action")[class: "small-button", width: 100px, height: 32px]
              Badge("READY")[class: "badge", width: 70px, height: 24px]
            }
            StatusBar[id: "demo-status", class: "chrome statusbar", width: 100%, height: 38px] {
              Text("StatusBar: framework ready")[class: "body-copy", grow: 1]
              Text("Same .xui and .xss on each backend")[class: "help"]
            }
            Text("Separator and Divider are equivalent line widgets; their orientation follows their bounds.")[class: "help"]
            Separator[class: "separator"]
            Divider[class: "divider"]
          }
        }
      }

      // 6. Display leaves and practical containers: scrolling, splitter, image, chrome, and checklist.
      Tab(title: "Containers") {
        ScrollView[class: "page-scroll", width: 100%, height: 100%, vertical: true, horizontal: false] {
          Column[class: "page", gap: 14px, pad: 18px] {
            Text("Containers, display, and scrolling")[class: "section-title"]
            Row(gap: 12)[width: 100%, align: Start] {
              ScrollView[id: "vertical-scroll", class: "scroll-demo", width: 36%, height: 194px, vertical: true, horizontal: false, scrollBehavior: "smooth", scrollSpeed: 42, change: onScrollChanged] {
                Column(gap: 6px) {
                  Text("Vertical ScrollView")[class: "panel-title"]
                  Button(label: "Scroll target A")[id: "scroll-target-a", class: "small-button", width: 100%, height: 34px]
                  Text("Item 02 — retained layout")[class: "scroll-item"]
                  Text("Item 03 — clipped to viewport")[class: "scroll-item"]
                  Text("Item 04 — wheel and keyboard")[class: "scroll-item"]
                  Text("Item 05 — drag the scrollbar")[class: "scroll-item"]
                  Text("Item 06 — nested descendants")[class: "scroll-item"]
                  Text("Item 07 — tab focus scrolls into view")[class: "scroll-item"]
                  Text("Item 08 — layout stays retained")[class: "scroll-item"]
                  Button(label: "Last item")[id: "scroll-target-last", class: "small-button", width: 100%, height: 34px]
                }
              }
              Column(gap: 10px)[grow: 1] {
                Image("xui-demo-image.png")[fit: Contain, tooltip: "Image is loaded through the renderer interface.", class: "demo-image", width: 100%, height: 108px]
                Toolbar[class: "chrome toolbar", width: 100%, height: 40px] {
                  Label("Toolbar")[class: "chrome-label"]
                  Button(label: "Action")[class: "small-button", width: 94px, height: 30px]
                  Badge("READY")[class: "badge", width: 70px, height: 24px]
                }
                StatusBar[class: "chrome statusbar", width: 100%, height: 34px] {
                  Text("StatusBar: all systems available")[class: "body-copy", grow: 1]
                  Spinner[class: "spinner", width: 20px, height: 20px]
                }
              }
            }
            Text("Horizontal ScrollView — drag the scrollbar or shift-wheel")[class: "field-label"]
            ScrollView[id: "horizontal-scroll", class: "scroll-demo horizontal-demo", width: 100%, height: 86px, horizontal: true, vertical: false, scrollbar: "always"] {
              Row(gap: 8)[width: 980px, height: 58px, align: Center] {
                Button(label: "Horizontal card one")[class: "small-button", width: 190px, height: 42px]
                Button(label: "Horizontal card two")[class: "small-button", width: 190px, height: 42px]
                Button(label: "Horizontal card three")[class: "small-button", width: 190px, height: 42px]
                Button(label: "Horizontal card four")[class: "small-button", width: 190px, height: 42px]
                Button(label: "Horizontal card five")[class: "small-button", width: 190px, height: 42px]
              }
            }
            Text("Resizable Split + checklist")[class: "section-title"]
            Split(direction: Horizontal)[id: "main-split", class: "split", ratio: 0.38, gutter: 8, width: 100%, height: 340px, minSize: 420x340] {
              Panel[id: "tasks-panel", class: "demo-panel pane pane-left", minSize: 190x140] {
                Text("CheckList")[class: "panel-title"]
                CheckList[gap: 5px, width: 100%] {
                  CheckItem(label: "Explore each tab", checked: true)[id: "task-layout", change: onTaskLayout, class: "check-item", width: 100%, height: 32px]
                  CheckItem(label: "Change a control value", checked: true)[id: "task-styles", change: onTaskStyles, class: "check-item", width: 100%, height: 32px]
                  CheckItem(label: "Keep rendering backend-neutral")[id: "task-backend", change: onTaskBackend, class: "check-item", width: 100%, height: 32px]
                  CheckItem(label: "Resize this split")[id: "task-resize", change: onTaskResize, class: "check-item", width: 100%, height: 32px]
                }
              }
              Panel[id: "content-panel", class: "demo-panel pane pane-right", minSize: 190x140] {
                Text("Panel container")[class: "panel-title"]
                Text("Text wraps inside its bounds. The Split gutter can be dragged, and both panes keep their authored minimum widths.")[class: "body-copy"]
                Text("This demo uses .xui structure and .xss styles with the shared GLFW/OpenGL backend interfaces.")[class: "body-copy"]
              }
            }
            Row(gap: 10)[width: 100%, align: Center] {
              Text("Tasks checked: 2 / 4")[id: "tasks-readout", class: "value-readout", width: 200px, height: 30px]
              Text("Scroll position: 0, 0")[id: "scroll-position-readout", class: "value-readout", grow: 1, height: 30px]
              Button(label: "Reveal last item")[press: onScrollToTarget, class: "small-button", width: 170px, height: 34px]
            }
          }
        }
      }
      // Docking workspace: drag a title/tab to an edge to split, center to tab, or outside to float.
      Tab(title: "Docking") {
        Column[class: "page", gap: 10px, pad: 16px, width: 100%, height: 100%, minSize: 0x0] {
          Text("Dockable workspace")[class: "section-title"]
          Text("Drag a panel title or tab. Drop near an edge to create a nested split, drop in the center to make a tab, and release outside the workspace to float it. Drag the gutters to resize; press Escape during a drag to cancel.")[class: "help"]
          Text("Dock values update when you dock, undock, resize, switch tabs, or close a panel.")[id: "dock-readout", class: "value-readout", width: 100%, height: 30px]
          DockHost[id: "dock-workspace", class: "docking-host", width: 100%, grow: 1, gutter: 7px, headerHeight: 30px, minSize: 520x300] {
            DockPanel(title: "Editor")[id: "dock-editor", icon: "E", region: "Center", closable: false, preferredSize: 420x320, minSize: 220x170, class: "dock-panel", dock: onDockChange, undock: onDockChange, resize: onDockChange, tabChange: onDockChange, close: onDockChange] {
              Column[width: 100%, height: 100%, pad: 12px, gap: 8px] {
                Text("Central editor panel")[class: "panel-title"]
                Text("This panel begins in the center. Dock another tab here, or drag it to an edge to create a nested split.")[class: "body-copy"]
                TextBox[id: "dock-editor-input", value: "Edit this text", class: "field", width: 100%, height: 38px]
              }
            }
            DockPanel(title: "Hierarchy")[id: "dock-hierarchy", icon: "H", region: "Left", target: "dock-editor", closable: true, preferredSize: 220x300, minSize: 150x160, class: "dock-panel", dock: onDockChange, undock: onDockChange, resize: onDockChange, tabChange: onDockChange, close: onDockChange] {
              Column[width: 100%, height: 100%, pad: 10px, gap: 6px] {
                Text("Scene objects")[class: "panel-title"]
                CheckBox[id: "dock-visible", label: "Show active object", checked: true, class: "checkbox", width: 100%, height: 34px]
                Text("Drag this tab to another edge or group.")[class: "help"]
              }
            }
            DockPanel(title: "Inspector")[id: "dock-inspector", icon: "I", region: "Right", target: "dock-editor", closable: true, preferredSize: 240x300, minSize: 160x160, class: "dock-panel", dock: onDockChange, undock: onDockChange, resize: onDockChange, tabChange: onDockChange, close: onDockChange] {
              Column[width: 100%, height: 100%, pad: 10px, gap: 8px] {
                Text("Properties")[class: "panel-title"]
                Slider[id: "dock-inspector-slider", value: 0.65, class: "slider", width: 100%, height: 30px, change: onDockChange]
                Text("The right pane has an explicit minimum size.")[class: "body-copy"]
              }
            }
            DockPanel(title: "Console")[id: "dock-console", icon: "C", region: "Bottom", target: "dock-editor", closable: true, preferredSize: 420x150, minSize: 240x90, class: "dock-panel", dock: onDockChange, undock: onDockChange, resize: onDockChange, tabChange: onDockChange, close: onDockChange] {
              Column[width: 100%, height: 100%, pad: 10px, gap: 6px] {
                Text("Build output")[class: "panel-title"]
                Text("Ready. Drag a panel header to rearrange this workspace.")[class: "body-copy"]
              }
            }
            DockPanel(title: "Preview")[id: "dock-preview", icon: "P", region: "Center", target: "dock-editor", closable: true, preferredSize: 320x240, minSize: 180x140, class: "dock-panel", dock: onDockChange, undock: onDockChange, resize: onDockChange, tabChange: onDockChange, close: onDockChange] {
              Column[width: 100%, height: 100%, pad: 12px, gap: 8px] {
                Text("Tabbed center panel")[class: "panel-title"]
                ProgressBar[id: "dock-preview-progress", value: 0.72, class: "progress", width: 100%, height: 18px]
                Text("Use the tab strip to switch between Editor and Preview.")[class: "body-copy"]
              }
            }
          }
        }
      }
    }
  }
}
